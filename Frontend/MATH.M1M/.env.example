# URL del backend FastAPI (obligatorio con prefijo EXPO_PUBLIC_)
# Producción (Render):
EXPO_PUBLIC_API_URL=https://taskpin.onrender.com
# Local:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Opcional: override del WebSocket si difiere del API (normalmente no hace falta).
# EXPO_PUBLIC_WS_URL=wss://taskpin.onrender.com
